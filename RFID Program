#include <SPI.h>
#include <MFRC522.h>

#define SS_PIN 10
#define RST_PIN 9

#define GREEN_LED 6
#define RED_LED 7

MFRC522 rfid(SS_PIN, RST_PIN);

void setup() {

  Serial.begin(9600);

  SPI.begin();
  rfid.PCD_Init();

  pinMode(GREEN_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);

  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, LOW);

  Serial.println("------------------------------");
  Serial.println("RFID STUDENT IDENTIFICATION");
  Serial.println("------------------------------");
  Serial.println("Scan Student RFID Card...");
}


void loop() {

  // Check for a new RFID card
  if (!rfid.PICC_IsNewCardPresent()) {
    return;
  }

  // Read RFID card
  if (!rfid.PICC_ReadCardSerial()) {
    return;
  }

  String uid = "";

  for (byte i = 0; i < rfid.uid.size; i++) {

    if (rfid.uid.uidByte[i] < 0x10) {
      uid += "0";
    }

    uid += String(rfid.uid.uidByte[i], HEX);
  }

  uid.toUpperCase();

  Serial.println();
  Serial.print("Card UID: ");
  Serial.println(uid);

  identifyStudent(uid);

  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();

  delay(2000);

  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, LOW);

  Serial.println();
  Serial.println("Scan Next Student Card...");
}


void identifyStudent(String uid) {

  // STUDENT 1
  if (uid == "2A364E32") {

    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);

    Serial.println("------------------------------");
    Serial.println("ACCESS GRANTED");
    Serial.println("------------------------------");

    Serial.println("Name       :MANI");
    Serial.println("Roll Number: 25MCA047");
    Serial.println("Department : MCA");
    Serial.println("Year       : 2nd Year");
  }


  // STUDENT 2
  else if (uid == "BC46FC2E") {

    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);

    Serial.println("------------------------------");
    Serial.println("ACCESS GRANTED");
    Serial.println("------------------------------");

    Serial.println("Name       : Student Two");
    Serial.println("Roll Number: 102");
    Serial.println("Department : ECE");
    Serial.println("Year       : 2nd Year");
  }


  // STUDENT 3
  else if (uid == "0746CF31") {

    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);

    Serial.println("------------------------------");
    Serial.println("ACCESS GRANTED");
    Serial.println("------------------------------");

    Serial.println("Name       : MONISH");
    Serial.println("Roll Number: 103");
    Serial.println("Department : MECH");
    Serial.println("Year       : 2nd Year");
  }


  // UNKNOWN CARD
  else {

    digitalWrite(GREEN_LED, LOW);
    digitalWrite(RED_LED, HIGH);

    Serial.println("------------------------------");
    Serial.println("ACCESS DENIED");
    Serial.println("------------------------------");

    Serial.println("Student Not Registered");

    Serial.print("Unknown UID: ");
    Serial.println(uid);
  }
}


/*
========================================
RFID STUDENT IDENTIFICATION
CONNECTION DETAILS
========================================

MFRC522 RFID RC522     Arduino UNO
----------------------------------------
SDA / SS               -> Pin 10
SCK                    -> Pin 13
MOSI                   -> Pin 11
MISO                   -> Pin 12
IRQ                    -> Not Connected
GND                    -> GND
RST                    -> Pin 9
3.3V                   -> 3.3V

LED CONNECTION
----------------------------------------
GREEN LED:
Arduino Pin 6 -> 220Ω Resistor -> LED Anode (+)
LED Cathode (-) -> GND

RED LED:
Arduino Pin 7 -> 220Ω Resistor -> LED Anode (+)
LED Cathode (-) -> GND

SERIAL MONITOR
----------------------------------------
Baud Rate -> 9600

========================================
*/


