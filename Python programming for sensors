#include <DHT.h>

#define DHTPIN 2
#define DHTTYPE DHT11

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(9600);
  dht.begin();
}

void loop() {
  float humidity = dht.readHumidity();
  float temperature = dht.readTemperature();

  if (isnan(humidity) || isnan(temperature)) {
    Serial.println("ERROR");
  } else {
    // Send temperature and humidity as comma-separated values
    Serial.print(temperature);
    Serial.print(",");
    Serial.println(humidity);
  }

  delay(2000);
}


Python code 


import serial

# Change COM3 to the Arduino's port on your computer
arduino = serial.Serial("COM3", 9600, timeout=2)

temperature_readings = []
humidity_readings = []
temperature_threshold = 30

print("Reading DHT11 data. Press Ctrl+C to stop.")

try:
    while True:
        line = arduino.readline().decode("utf-8").strip()

        if not line:
            continue

        if line == "ERROR":
            print("Could not read the DHT11 sensor.")
            continue

        try:
            temperature_text, humidity_text = line.split(",")
            temperature = float(temperature_text)
            humidity = float(humidity_text)
        except ValueError:
            continue

        temperature_readings.append(temperature)
        humidity_readings.append(humidity)

        average_temperature = sum(temperature_readings) / len(temperature_readings)
        average_humidity = sum(humidity_readings) / len(humidity_readings)

        print("\nSensor Data Processing")
        print("----------------------")
        print("Temperature:", temperature, "°C")
        print("Humidity:", humidity, "%")
        print("Average Temperature:", round(average_temperature, 1), "°C")
        print("Average Humidity:", round(average_humidity, 1), "%")
        print("Minimum Temperature:", min(temperature_readings), "°C")
        print("Maximum Temperature:", max(temperature_readings), "°C")

        if temperature > temperature_threshold:
            print("Warning: High Temperature")
        else:
            print("Status: Normal Temperature")

except KeyboardInterrupt:
    print("\nStopped reading sensor data.")

finally:
    arduino.close()

Step to do this program: 

1. Connect DHT11 VCC to Arduino 5V.
2. Connect DHT11 GND to Arduino GND.
3. Connect DHT11 DATA to Arduino D2.
4. Connect Arduino Uno to the Windows computer with the USB cable.
5. Upload the Arduino sketch using the Arduino IDE.
6. Close the Arduino IDE Serial Monitor.
7. Open Command Prompt.
8. Check Python is installed:
   py --version
9. Install the serial package:
   py -m pip install pyserial
10. Check the Arduino COM port in Arduino IDE: Tools > Port.
11. Open the Python file and replace COM3 with your Arduino's COM port, if needed.
12. In Command Prompt, go to the folder containing the Python file.
    Example: cd %USERPROFILE%\Desktop
13. Run the Python program:
    py sensor_monitor.py
14. Read the temperature and humidity output in Command Prompt.
15. Press Ctrl+C to stop the program.


